<?xml version="1.0" encoding="utf-8"?>
<!--
   Workspace snapshots and window bounds are strictly machine-local (tied to this device's
   displays, Virtual Desks, and boot count), so cloud backup and cross-device transfer are
   explicitly excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
